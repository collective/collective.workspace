<?xml version="1.0" encoding="utf-8"?>
<object xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        meta_type="Plone Actions Tool"
        name="portal_actions"
>
  <object meta_type="CMF Action Category"
          name="object"
  >
    <object meta_type="CMF Action"
            name="team-roster"
            i18n:domain="plone"
    >
      <property name="title"
                i18n:translate=""
      >Roster</property>
      <property name="description"
                i18n:translate=""
      />
      <property name="url_expr">string:${context/absolute_url}/team-roster</property>
      <property name="icon_expr" />
      <property name="available_expr">nocall:context/@@team-roster|nothing</property>
      <property name="permissions">
        <element value="collective.workspace: View roster" />
      </property>
      <property name="visible">True</property>
    </object>
  </object>
</object>
